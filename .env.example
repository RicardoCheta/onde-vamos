# Copia este ficheiro para ".env" e preenche com os teus valores.
# NUNCA commites o ficheiro ".env" (já está no .gitignore).

# Supabase — Project Settings > API no dashboard do Supabase
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=coloca_aqui_a_tua_anon_key

# Google Places API — Google Cloud Console > APIs & Services > Credentials
# Precisa de ter ativadas: "Places API" (Nearby Search + Place Details)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=coloca_aqui_a_tua_api_key
